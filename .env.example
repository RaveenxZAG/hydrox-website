APP_NAME="Hydrox Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Australia/Melbourne

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/home/hydro851/persistent/hydrox-website/database/database.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

# Optional: MySQL migration source (for hydrox:migrate-to-sqlite)
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_DATABASE=hydro851_dev
SOURCE_DB_USERNAME=hydro851_dev
SOURCE_DB_PASSWORD=

# Maintenance trigger (only enabled temporarily during manual cutover if terminal is unavailable)
SQLITE_MIGRATION_ENABLED=false
INTERNAL_MAINTENANCE_TOKEN=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
FILESYSTEM_LOCAL_ROOT=/home/hydro851/persistent/hydrox-website/storage/app/private
FILESYSTEM_PUBLIC_ROOT=/home/hydro851/persistent/hydrox-website/storage/app/public

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=admin@hydrox.au
MAIL_FROM_NAME="${APP_NAME}"

MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER=admin@hydrox.au

COMPANY_NAME="Hydrox Facility Management"
COMPANY_PHONE="0418 222 477"
COMPANY_EMAIL=admin@hydrox.au
COMPANY_ADDRESS=

# Generate a private random token before connecting the WordPress booking plugin.
HYDROX_PORTAL_URL=https://portal.hydrox.au
HYDROX_BOOKING_TOKEN=

# Set this securely in the deployment environment before running the database seeder.
HYDROX_ADMIN_PASSWORD=

# Revoke any token exposed in chat or source control. Store the replacement only in the deployment environment.
# Start a conversation with the bot before configuring the destination chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

VITE_APP_NAME="${APP_NAME}"
